      `Caixa #${session.id}`,
      escapeHtml(session.cashier),
      formatReportDate(session.opened_at, true),
      closed ? formatReportDate(session.closed_at, true) : "Aberto no fim do período",
      formatMoney(session.opening_cents),
      formatMoney(session.expected_cents),
      closed ? formatMoney(session.closing_cents) : "—",
      closed ? formatMoney(difference) : "—",
