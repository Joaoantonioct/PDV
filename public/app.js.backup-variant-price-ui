const CODE128_PATTERNS = [
  "212222", "222122", "222221", "121223", "121322", "131222", "122213", "122312", "132212", "221213",
  "221312", "231212", "112232", "122132", "122231", "113222", "123122", "123221", "223211", "221132",
  "221231", "213212", "223112", "312131", "311222", "321122", "321221", "312212", "322112", "322211",
  "212123", "212321", "232121", "111323", "131123", "131321", "112313", "132113", "132311", "211313",
  "231113", "231311", "112133", "112331", "132131", "113123", "113321", "133121", "313121", "211331",
  "231131", "213113", "213311", "213131", "311123", "311321", "331121", "312113", "312311", "332111",
  "314111", "221411", "431111", "111224", "111422", "121124", "121421", "141122", "141221", "112214",
  "112412", "122114", "122411", "142112", "142211", "241211", "221114", "413111", "241112", "134111",
  "111242", "121142", "121241", "114212", "124112", "124211", "411212", "421112", "421211", "212141",
  "214121", "412121", "111143", "111341", "131141", "114113", "114311", "411113", "411311", "113141",
  "114131", "311141", "411131",
];
const CODE128_START_C = "211232";
const CODE128_CODE_B = "114131";
const CODE128_STOP = "2331112";
const CODE128_QUIET_ZONE_MODULES = 10;

function code128Barcode(value) {
  const barcode = String(value ?? "");
  if (!/^\d{13}$/.test(barcode)) return null;
  const digits = [...barcode].map(Number);
  const checkDigit = digits.slice(0, 12).reduce((sum, digit, index) =>
    sum + digit * (index % 2 === 0 ? 1 : 3), 0);
  if ((10 - (checkDigit % 10)) % 10 !== digits[12]) return null;

  const codewords = [105];
  for (let index = 0; index < 12; index += 2) {
    codewords.push(Number(barcode.slice(index, index + 2)));
  }
  codewords.push(100, Number(barcode[12]) + 16);
  const checkCodeword = codewords.reduce((sum, codeword, index) =>
    sum + codeword * (index || 1), 0) % 103;
  const encoded = [CODE128_START_C];
  for (const codeword of codewords.slice(1, 7)) encoded.push(CODE128_PATTERNS[codeword]);
  encoded.push(CODE128_CODE_B, CODE128_PATTERNS[Number(barcode[12]) + 16], CODE128_PATTERNS[checkCodeword], CODE128_STOP);
  const runs = encoded.flatMap((pattern) => [...pattern].map(Number));
  const modules = encoded.reduce((sum, pattern) =>
    sum + [...pattern].reduce((patternSum, width) => patternSum + Number(width), 0), 0);
  return { runs, moduleCount: modules + CODE128_QUIET_ZONE_MODULES * 2 };
}

function barcodeSvg(value) {
  const barcode = String(value ?? "");
  const pattern = code128Barcode(barcode);
  if (!pattern) return "";
  let moduleX = CODE128_QUIET_ZONE_MODULES;
  let isBar = true;
  const bars = pattern.runs.flatMap((run) => {
    const x = moduleX;
    moduleX += run;
    const bar = isBar ? [`<rect x="${x}" y="2" width="${run}" height="48"/>`] : [];
    isBar = !isBar;
    return bar;
  }).join("");
  return `<svg class="barcode-symbol" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${pattern.moduleCount} 58" preserveAspectRatio="none" role="img" aria-label="Código Code 128 ${barcode}" shape-rendering="crispEdges">
    <g fill="#111">${bars}</g><text x="${pattern.moduleCount / 2}" y="56" text-anchor="middle" fill="#111" font-family="Arial,sans-serif" font-size="8">${barcode}</text>
  </svg>`;
}

function pdfBarcodeBytes(labels, dimensions, showName, showPrice) {
  const pageWidthMm = 210;
  const pageHeightMm = 297;
  const marginMm = 3.5;
  const gapMm = 1;
  const pointsPerMm = 72 / 25.4;
  const columns = Math.max(1, Math.floor((pageWidthMm - 2 * marginMm + gapMm) / (dimensions.width + gapMm)));
  const rowsPerPage = Math.min(
    Math.max(1, Math.floor((pageHeightMm - 2 * marginMm + gapMm) / (dimensions.height + gapMm))),
    Math.floor(MAX_LABEL_COPIES / columns),
  );
  const labelsPerPage = columns * rowsPerPage;
  const pageCount = Math.ceil(labels.length / labelsPerPage);
  const pageWidth = pageWidthMm * pointsPerMm;
  const pageHeight = pageHeightMm * pointsPerMm;
  const textCanvas = document.createElement("canvas");
  const textContext = textCanvas.getContext("2d");
  const encodeText = (value) => {
    const specialCharacters = {
      "€": 0x80, "‚": 0x82, "ƒ": 0x83, "„": 0x84, "…": 0x85, "†": 0x86, "‡": 0x87,
      "ˆ": 0x88, "‰": 0x89, "Š": 0x8a, "‹": 0x8b, "Œ": 0x8c, "Ž": 0x8e, "‘": 0x91,
      "’": 0x92, "“": 0x93, "”": 0x94, "•": 0x95, "–": 0x96, "—": 0x97, "˜": 0x98,
      "™": 0x99, "š": 0x9a, "›": 0x9b, "œ": 0x9c, "ž": 0x9e, "Ÿ": 0x9f,
    };
    return [...String(value)].map((character) => {
      const codePoint = character.codePointAt(0);
      if (specialCharacters[character]) return specialCharacters[character];
      return codePoint >= 32 && codePoint <= 255 ? codePoint : 63;
    });
  };
  const pdfString = (value) => encodeText(value).map((byte) => {
    const character = String.fromCharCode(byte);
    return ["\\", "(", ")"].includes(character) ? `\\${character}` : character;
  }).join("");
  const textWidth = (value, size, bold) => {
    if (!textContext) return [...String(value)].length * size * 0.55;
    textContext.font = `${bold ? "bold " : ""}${size}pt Arial`;
    return textContext.measureText(value).width * 0.75;
  };
  const drawText = (parts, value, centerX, baselineY, size, bold, maxWidth) => {
    if (!value) return;
    const width = textWidth(value, size, bold);
    const scale = width > maxWidth ? maxWidth / width * 100 : 100;
    parts.push(`BT /F${bold ? 2 : 1} ${size.toFixed(2)} Tf ${scale.toFixed(2)} Tz ${(centerX - Math.min(width, maxWidth) / 2).toFixed(2)} ${baselineY.toFixed(2)} Td (${pdfString(value)}) Tj ET`);
  };
  const partsByPage = Array.from({ length: pageCount }, () => []);
  labels.forEach((product, index) => {
    const pageIndex = Math.floor(index / labelsPerPage);
    const positionOnPage = index % labelsPerPage;
    const row = Math.floor(positionOnPage / columns);
    const column = positionOnPage % columns;
    const labelsOnPage = Math.min(labelsPerPage, labels.length - pageIndex * labelsPerPage);
    const rowsOnPage = Math.ceil(labelsOnPage / columns);
    const labelsInRow = Math.min(columns, labelsOnPage - row * columns);
    const rowWidthMm = labelsInRow * dimensions.width + (labelsInRow - 1) * gapMm;
    const gridHeightMm = rowsOnPage * dimensions.height + (rowsOnPage - 1) * gapMm;
    const x = ((pageWidthMm - rowWidthMm) / 2 + column * (dimensions.width + gapMm)) * pointsPerMm;
    const top = ((pageHeightMm - gridHeightMm) / 2 + row * (dimensions.height + gapMm)) * pointsPerMm;
    const width = dimensions.width * pointsPerMm;
    const height = dimensions.height * pointsPerMm;
    const pad = 1.1 * pointsPerMm;
    const innerWidth = width - 2 * pad;
    const innerHeight = height - 2 * pad;
    const symbolWidth = width - 2 * pad;
    const symbolX = x + (width - symbolWidth) / 2;
    const barcode = code128Barcode(product.barcode);
    const parts = partsByPage[pageIndex];

    const nameFontSize = 6;
    const priceFontSize = 6.5;
    const barcodeNumberSize = 5.5;
    const nameSlot = showName ? 7.5 : 0;
    const numberSlot = 7;
    const priceSlot = showPrice ? 8 : 0;
    const gapCount = Number(showName) + 1 + Number(showPrice);
    const contentGap = 2;
    const remainingHeight = Math.max(0, innerHeight - nameSlot - numberSlot - priceSlot - gapCount * contentGap);
    const barHeight = Math.min(innerHeight * 0.55, remainingHeight);
    const contentHeight = nameSlot + barHeight + numberSlot + priceSlot + gapCount * contentGap;
    let cursorTop = top + (height - contentHeight) / 2;

    parts.push(`0.78 G 0.3 w [1.2 1.2] 0 d ${(x + 0.5).toFixed(2)} ${(pageHeight - top - height + 0.5).toFixed(2)} ${(width - 1).toFixed(2)} ${(height - 1).toFixed(2)} re S [] 0 d 0 G`);

    if (showName) {
      drawText(parts, product.name, x + width / 2, pageHeight - cursorTop - nameFontSize * 0.85, nameFontSize, true, innerWidth);
      cursorTop += nameSlot + contentGap;
    }

    const unitX = symbolWidth / barcode.moduleCount;
    const barcodeTop = cursorTop;
    let moduleX = CODE128_QUIET_ZONE_MODULES;
    let isBar = true;
    const barBottom = pageHeight - barcodeTop - barHeight;
    const barRects = barcode.runs.flatMap((run) => {
      const currentX = moduleX;
      moduleX += run;
      const rect = isBar ? [`${currentX} ${barBottom.toFixed(2)} ${run} ${barHeight.toFixed(2)} re`] : [];
      isBar = !isBar;
      return rect;
    });
    parts.push(`0 0 0 rg q ${unitX.toFixed(6)} 0 0 1 ${symbolX.toFixed(2)} 0 cm ${barRects.join(" ")} f Q`);
    cursorTop += barHeight + contentGap;
    drawText(parts, product.barcode, x + width / 2, pageHeight - cursorTop - numberSlot * 0.72, barcodeNumberSize, false, innerWidth);
    cursorTop += numberSlot;

    if (showPrice) {
      cursorTop += contentGap;
      drawText(parts, formatMoney(product.price_cents), x + width / 2, pageHeight - cursorTop - priceFontSize * 0.85, priceFontSize, true, innerWidth);
    }
  });

  const objects = [
    "<< /Type /Catalog /Pages 2 0 R >>",
    `<< /Type /Pages /Kids [${Array.from({ length: pageCount }, (_, index) => `${5 + index * 2} 0 R`).join(" ")}] /Count ${pageCount} >>`,
    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>",
    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>",
  ];
  partsByPage.forEach((parts, index) => {
    const pageObjectId = 5 + index * 2;
    const streamObjectId = pageObjectId + 1;
    const stream = parts.join("\n");
    objects.push(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${(pageWidth).toFixed(2)} ${(pageHeight).toFixed(2)}] /Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents ${streamObjectId} 0 R >>`);
    objects.push(`<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`);
  });

  let documentText = "%PDF-1.4\n";
  const offsets = [0];
  objects.forEach((object, index) => {
    offsets.push(documentText.length);
    documentText += `${index + 1} 0 obj\n${object}\nendobj\n`;
  });
  const xrefOffset = documentText.length;
  documentText += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`;
  offsets.slice(1).forEach((offset) => {
    documentText += `${String(offset).padStart(10, "0")} 00000 n \n`;
  });
  documentText += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF`;
  return Uint8Array.from(documentText, (character) => character.charCodeAt(0));
}

function getLabelDimensions() {
  const preset = $("#labelSize")?.value ?? "50x30";
  if (preset !== "custom") {
    const [width, height] = preset.split("x").map(Number);
    return { width, height };
  }
  const width = Number($("#customLabelWidth")?.value);
  const height = Number($("#customLabelHeight")?.value);
  if (!Number.isFinite(width) || !Number.isFinite(height) || width < 15 || width > 100 || height < 10 || height > 100) {
    throw new Error("No tamanho personalizado, informe largura de 15 a 100 mm e altura de 10 a 100 mm.");
  }
  return { width, height };
}

function getSelectedLabelItems() {
  return state.labelProducts.flatMap((product) => {
    const copies = Number(state.labelCopies[product.id] ?? 0);
    return copies > 0 ? [{ product, copies }] : [];
  });
}

function renderBarcodeLabel(product, dimensions, showName, showPrice) {
  const validBarcode = barcodeSvg(product.barcode);
  return `<article class="barcode-label ${validBarcode ? "" : "barcode-invalid"}" style="--label-width:${dimensions.width}mm;--label-height:${dimensions.height}mm;width:${dimensions.width}mm;height:${dimensions.height}mm">
    ${showName ? `<strong class="barcode-product-name">${escapeHtml(product.name)}</strong>` : ""}
    ${validBarcode || `<span class="barcode-error">Código EAN inválido</span>`}
    ${showPrice ? `<span class="barcode-product-price">${formatMoney(product.price_cents)}</span>` : ""}
  </article>`;
}

function updateBarcodePreview() {
  const preview = $("#barcodePreview");
  if (!preview) return;
  const selection = getSelectedLabelItems();
  const total = selection.reduce((sum, item) => sum + item.copies, 0);
  $("#labelCount").textContent = `${total}/${MAX_LABEL_COPIES} etiquetas selecionadas`;
  $("#downloadBarcodeLabelsPdf").disabled = total === 0 || total > MAX_LABEL_COPIES;
  if (total > MAX_LABEL_COPIES) {
    preview.innerHTML = "";
    $("#labelSizeError").textContent = `O limite é de ${MAX_LABEL_COPIES} etiquetas por folha.`;
    return;
  }
  try {
    const dimensions = getLabelDimensions();
    const qualityHint = $("#barcodeQualityHint");
    const code = code128Barcode(state.labelProducts.find((product) => product.barcode)?.barcode);
    const moduleWidthMm = code ? (dimensions.width - 2.2) / code.moduleCount : 0;
    qualityHint.textContent = moduleWidthMm < 0.19
      ? "Atenção: esta etiqueta é estreita para o Code 128. O código pode não ser lido por alguns leitores; aumente a largura da etiqueta se possível."
      : "O código usa Code 128 para que leitores retornem os 13 dígitos sem interpretar a faixa interna 20–29 como preço/peso. Habilite Code 128 no leitor e imprima em tamanho real, sem economia de tinta.";
    qualityHint.classList.toggle("notice", moduleWidthMm < 0.19);
    const showName = $("#labelShowName").checked;
    const showPrice = $("#labelShowPrice").checked;
    const labels = selection.flatMap(({ product, copies }) =>
      Array.from({ length: copies }, () => renderBarcodeLabel(product, dimensions, showName, showPrice)));
    preview.style.setProperty("--label-width", `${dimensions.width}mm`);
    preview.style.setProperty("--label-height", `${dimensions.height}mm`);
    preview.innerHTML = labels.length
      ? labels.join("")
      : `<div class="panel empty label-preview-empty">Selecione produtos e informe a quantidade de etiquetas para visualizar.</div>`;
    $("#labelSizeError").textContent = "";
  } catch (error) {
    preview.innerHTML = "";
    $("#labelSizeError").textContent = error.message;
    $("#downloadBarcodeLabelsPdf").disabled = true;
  }
}

function downloadBarcodeLabelsPdf() {
  const selection = getSelectedLabelItems();
  const total = selection.reduce((sum, item) => sum + item.copies, 0);
  if (!total || total > MAX_LABEL_COPIES) {
    throw new Error(`Selecione de 1 a ${MAX_LABEL_COPIES} etiquetas para gerar o PDF.`);
  }
  const invalidProduct = selection.find(({ product }) => !code128Barcode(product.barcode));
  if (invalidProduct) throw new Error(`O código interno de "${invalidProduct.product.name}" é inválido.`);
  const dimensions = getLabelDimensions();
  const labels = selection.flatMap(({ product, copies }) => Array.from({ length: copies }, () => product));
  const pdf = pdfBarcodeBytes(labels, dimensions, $("#labelShowName").checked, $("#labelShowPrice").checked);
  const url = URL.createObjectURL(new Blob([pdf], { type: "application/pdf" }));
  const link = document.createElement("a");
  link.href = url;
  link.download = `etiquetas-${new Date().toISOString().slice(0, 10)}.pdf`;
  document.body.append(link);
  link.click();
  link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 60_000);
}

