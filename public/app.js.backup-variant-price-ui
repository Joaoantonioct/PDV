  const row = event.target.closest("tr");
  const button = $("[data-action='link-site-product']", row);
  if (button) button.disabled = !event.target.value;
});
$("#branchSelect").addEventListener("change", (event) => {
  state.branchId = Number(event.target.value);
  localStorage.setItem("pdv_branch", String(state.branchId));
  state.cart = [];
  state.selectedProductId = null;
  state.searchMatchProductId = null;
  state.lastAutoAddedCode = null;
  state.paymentRows = [];
  state.customerId = "";
  if ($("#discountInput")) $("#discountInput").value = "0.00";
  loadView(state.view).catch((error) => showToast(error.message, true));
});
$("#logoutButton").addEventListener("click", async () => {
  try {
    await api("/api/auth/logout", { method: "POST", body: {} });
  } catch (error) {
    showToast(error.message, true);
  }
  state.user = null;
  state.csrf = "";
  state.cart = [];
  state.customerId = "";
  state.paymentRows = [];
  setAuthMode(false);
});
document.addEventListener("input", (event) => {
  if (event.target.matches?.("[data-size-qty]")) updateProductSizeTotal();
  if (event.target.matches?.("[data-product-color-name]")) {
    const color = state.productColorRows[Number(event.target.dataset.productColorName)];
    if (color) color.name = event.target.value;
  }
  if (event.target.matches?.("[data-color-quantity]")) {
    const [colorIndex, ...sizeParts] = event.target.dataset.colorQuantity.split(":");
    const color = state.productColorRows[Number(colorIndex)];
    if (color) {
      const size = sizeParts.join(":");
      if (size === "") color.quantity = Number(event.target.value || 0);
      else color.quantities[size] = Number(event.target.value || 0);
      updateProductColorTotal();
    }
  }
  if (event.target.matches?.("[data-color-price]")) {
    const [colorIndex, ...sizeParts] = event.target.dataset.colorPrice.split(":");
    const color = state.productColorRows[Number(colorIndex)];
    if (color) {
      const size = sizeParts.join(":");
      if (size === "") color.price = event.target.value;
      else color.prices[size] = event.target.value;
    }
  }
  if (event.target.id === "productDescription") {
    $("#productDescriptionCount").textContent = `${event.target.value.length}/1000 caracteres`;
  }
  if (event.target.id === "labelProductSearch") {
    const query = normalizeProductSearch(event.target.value);
    $$("#labelProductList .label-product-row").forEach((row) => {
      row.classList.toggle("hidden", !normalizeProductSearch(row.dataset.search).includes(query));
    });
  }
  if (event.target.matches("[data-label-copies]")) {
    const productId = Number(event.target.dataset.labelCopies);
    let copies = Number(event.target.value);
    if (!Number.isSafeInteger(copies) || copies < 0) copies = 0;
    copies = Math.min(copies, MAX_LABEL_COPIES);
    const otherCopies = Object.entries(state.labelCopies)
      .filter(([id]) => Number(id) !== productId)
      .reduce((sum, [, count]) => sum + Number(count), 0);
    if (copies + otherCopies > MAX_LABEL_COPIES) {
      copies = Math.max(0, MAX_LABEL_COPIES - otherCopies);
      showToast(`É possível selecionar no máximo ${MAX_LABEL_COPIES} etiquetas por folha.`, true);
    }
    event.target.value = String(copies);
    state.labelCopies[productId] = copies;
    updateBarcodePreview();
  }
  if (event.target.id === "customLabelWidth" || event.target.id === "customLabelHeight") {
    updateBarcodePreview();
  }
  if (event.target.id === "productSearch") {
    const query = normalizeProductSearch(event.target.value);
    if (query !== state.lastAutoAddedCode) state.lastAutoAddedCode = null;
    const exactVariant = findExactVariantCode(query);
    if (exactVariant) {
      state.lastAutoAddedCode = query;
      addProductToCart(exactVariant.product.id, exactVariant.variant.id)
        .catch((error) => showToast(error.message, true));
      return;
    }
    const exactCodeProduct = findExactProductCode(query);
    if (exactCodeProduct) {
      state.lastAutoAddedCode = query;
      addProductToCart(exactCodeProduct.id).catch((error) => showToast(error.message, true));
      return;
    }
    const filtered = state.products.filter((product) =>
      [product.name, product.sku, product.barcode, product.category]
        .some((value) => normalizeProductSearch(value).includes(query)));
    const exactProduct = findExactSearchProduct(event.target.value);
    state.searchMatchProductId = exactProduct?.id ?? null;
    $("#productResults").innerHTML = renderProductTiles(filtered);
    updateSaleFocus();
  }
  if (event.target.id === "discountInput") updateSaleTotals();
  if (event.target.id === "inventorySearch") {
    const query = event.target.value.toLocaleLowerCase("pt-BR");
    $$("#view-products tbody tr").forEach((row) => {
      row.classList.toggle("hidden", !row.dataset.search.toLocaleLowerCase("pt-BR").includes(query));
    });
  }
  if (event.target.id === "customerSearch") {
    const query = event.target.value.toLocaleLowerCase("pt-BR");
    $$("#view-customers tbody tr").forEach((row) => {
      row.classList.toggle("hidden", !row.dataset.search.toLocaleLowerCase("pt-BR").includes(query));
    });
  }
});
document.addEventListener("change", (event) => {
  if (event.target.id === "saleCustomer") state.customerId = event.target.value;
  if (event.target.id === "productSizeTypeSelect") {
    updateProductCategoryFields([]);
  }
  if (event.target.id === "categorySelect") {
    const categoryId = Number(event.target.value);
    const category = state.categories.find(cat => cat.id === categoryId);
    const subcategorySelect = $("#subcategorySelect");
    if (subcategorySelect) {
      subcategorySelect.innerHTML = `<option value="">Selecione uma subcategoria</option>`;
      if (categoryId) {
        const subcategories = state.categories.filter(cat => cat.parent_id === categoryId);
        subcategories.forEach(sub => {
          subcategorySelect.innerHTML += `<option value="${sub.id}">${escapeHtml(sub.name)}</option>`;
        });
        subcategorySelect.disabled = false;
      } else {
        subcategorySelect.disabled = true;
      }
    }

    updateProductCategoryFields();
  }
  if (event.target.id === "subcategorySelect") updateProductCategoryFields();
  if (event.target.matches?.("[data-size-check]")) updateProductSizeTotal();
  if (event.target.matches?.("[data-color-size]")) {
    const [colorIndex, size] = event.target.dataset.colorSize.split(":");
    const color = state.productColorRows[Number(colorIndex)];
    if (color) {
      if (event.target.checked) {
        const quantityInput = event.target.closest("[data-color-size-row]").querySelector("[data-color-quantity]");
        color.quantities[size] = Number(quantityInput.value || 0);
      } else {
        delete color.quantities[size];
      }
      updateProductCategoryFields();
    }
  }
  if (event.target.matches?.("[data-product-color-image]")) {
    const index = Number(event.target.dataset.productColorImage);
    const color = state.productColorRows[index];
    const file = event.target.files?.[0];
    if (color && file) {
      const processing = optimizeProductImage(file).then((imageData) => {
        color.imageData = imageData;
        if (state.productColorRows.includes(color)) renderProductColorRows();
        return imageData;
      }).catch((error) => {
        event.target.value = "";
        color.imageData = null;
        showToast(error.message, true);
        renderProductColorRows();
        return null;
      });
      color.imagePromise = processing;
    }
  }
  if (event.target.id === "labelSize") {
    $("#customLabelSize").classList.toggle("hidden", event.target.value !== "custom");
    updateBarcodePreview();
  }
  if (event.target.id === "labelShowName" || event.target.id === "labelShowPrice") updateBarcodePreview();
  if (event.target.id === "productImageInput") {
    const input = event.target;
    const files = [...(input.files ?? [])];
    state.productImagesData = [];
    state.productImagesPromise = Promise.resolve([]);
    if (!files.length) return;
    if (files.length > 10) {
      input.value = "";
      showToast("Selecione no máximo 10 imagens.", true);
      return;
    }
    const processing = Promise.all(files.map(optimizeProductImage)).then((images) => {
      if (state.productImagesPromise !== processing) return [];
      const totalLength = images.reduce((total, image) => total + image.length, 0);
      if (totalLength > 1_300_000) {
        throw new Error("O conjunto das imagens ficou grande demais para sincronizar. Reduza a quantidade ou escolha imagens menores.");
      }
      state.productImagesData = images;
      state.productImageData = images[0];
      state.productImageDirty = true;
      $("#removeProductImage").checked = false;
      renderProductImagePreview(images[0]);
      $("#productImageSelectionHint").textContent = `${images.length} imagem(ns) selecionada(s); o PDV usa a primeira.`;
      return images;
    }).catch((error) => {
      if (state.productImagesPromise === processing) {
        input.value = "";
        state.productImagesData = [];
        state.productImageData = undefined;
        showToast(error.message, true);
      }
      return [];
    });
    state.productImagesPromise = processing;
  }
  if (event.target.id === "removeProductImage") {
    state.productImageDirty = true;
    state.productImageData = event.target.checked ? null : undefined;
    if (event.target.checked) clearProductImagePreview();
    else {
      const productId = Number($("#productForm").elements.productId.value);
      const product = state.products.find((item) => item.id === productId);
      if (product?.has_image) renderProductImagePreview(`/api/products/${product.id}/image`);
      else clearProductImagePreview();
    }
  }
  if (event.target.matches("[data-payment-method]")) {
    syncPaymentRows();
    $("#paymentRows").innerHTML = renderPaymentRows();
    updatePaymentBalance();
    updateSaleFocus();
  }
});
document.addEventListener("input", (event) => {
  if (event.target.matches("[data-payment-amount], [data-payment-received]")) {
    if (event.target.matches("[data-payment-amount]")) {
      state.paymentRows.forEach((payment) => { payment.autoAmount = false; });
    }
    syncPaymentRows();
    updatePaymentBalance();
    updateSaleFocus();
  }
});

document.addEventListener("keydown", (event) => {
  if (event.target.id !== "productSearch" || event.key !== "Enter") return;
  event.preventDefault();
  const search = normalizeProductSearch(event.target.value);
  if (!search) return;
  if (state.lastAutoAddedCode === search) return;
  const exactProduct = findExactSearchProduct(search);
  const availableProducts = state.products.filter((product) =>
    [product.name, product.sku, product.barcode, product.category]
      .some((value) => normalizeProductSearch(value).includes(search)));
  const product = exactProduct ?? (availableProducts.length === 1 ? availableProducts[0] : null);
  if (!product) {
    showToast("Digite um nome ou código exato, ou refine a busca até encontrar um produto.", true);
    return;
  }
  addProductToCart(product.id).catch((error) => showToast(error.message, true));
});

initialize();
