}

async function loadReport(month) {
  if (!/^\d{4}-\d{2}$/.test(month)) throw new Error("Selecione um mês válido.");
  const [year, monthNumber] = month.split("-").map(Number);
  if (monthNumber < 1 || monthNumber > 12) throw new Error("Selecione um mês válido.");
  const lastDay = new Date(Date.UTC(year, monthNumber, 0)).getUTCDate();
  const from = `${month}-01`;
  const to = `${month}-${String(lastDay).padStart(2, "0")}`;
  const report = await api(`/api/reports?branchId=${state.branchId}&from=${from}&to=${to}`);
  if (!Array.isArray(report.siteDaily) || !Array.isArray(report.siteSales)
    || !Array.isArray(report.siteSaleItems) || !Number.isInteger(report.site_order_count)
    || !Number.isInteger(report.site_order_total_cents)) {
    throw new Error("Reinicie o servidor do PDV para atualizar o relatório com os pedidos do site.");
  }
  $("#reportResults").innerHTML = buildMonthlyReport(report, month);
  $("#printMonthlyReport").disabled = false;
  $("#exportSales").disabled = false;
  $("#exportSales").onclick = () => downloadSalesCsv(report.sales, report.siteSales, month);
  $("#printMonthlyReport").onclick = () => printMonthlyReport(report, month);
}

function printMonthlyReport(report, month) {
  const root = $("#printRoot");
  root.innerHTML = buildMonthlyReport(report, month);
  root.classList.add("monthly-print-root");
  const previousTitle = document.title;
  document.title = `Relatorio-mensal-${report.branch.name}-${month}`;
  const restoreTitle = () => {
    document.title = previousTitle;
    root.classList.remove("monthly-print-root");
    window.removeEventListener("afterprint", restoreTitle);
  };
  window.addEventListener("afterprint", restoreTitle, { once: true });
  window.print();
  setTimeout(restoreTitle, 60_000);
}

function downloadSalesCsv(sales, siteOrders, month) {
  const lines = [["Origem", "Venda/pedido", "Data e hora", "Operador", "Cliente", "Pagamento", "Subtotal (centavos)", "Desconto (centavos)", "Total (centavos)", "Status", "Motivo do cancelamento"],
    ...sales.map((sale) => [
      "PDV", sale.id, sale.created_at, sale.cashier, sale.customer ?? "", sale.payment_methods ?? "",
      sale.subtotal_cents, sale.discount_cents, sale.total_cents, sale.status, sale.cancel_reason ?? "",
    ]),
    ...siteOrders.map((order) => [
      "Site (sem pagamento)", order.order_id, order.created_at, "Site", "", "Não processado",
      order.total_cents, 0, order.total_cents, "PEDIDO NÃO PAGO", "",
    ])];
  const csv = lines.map((row) => row.map((value) => `"${String(value).replaceAll('"', '""')}"`).join(";")).join("\r\n");
  const link = document.createElement("a");
  link.href = URL.createObjectURL(new Blob(["\ufeff", csv], { type: "text/csv;charset=utf-8" }));
  link.download = `relatorio-vendas-${month}.csv`;
  link.click();
  setTimeout(() => URL.revokeObjectURL(link.href), 1000);
}

