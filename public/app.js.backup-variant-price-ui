const paymentLabels = {
  CASH: "Dinheiro",
  PIX: "Pix",
  DEBIT: "Cartão de débito",
  CREDIT: "Cartão de crédito",
  OTHER: "Outro",
};

const roleLabels = { ADMIN: "Administrador", MANAGER: "Gerente", CASHIER: "Operador" };
const MAX_LABEL_COPIES = 36;
const $ = (selector, root = document) => root.querySelector(selector);
const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

function escapeHtml(value) {
  return String(value ?? "").replace(/[&<>"']/g, (character) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
  })[character]);
}

function renderPaymentRows() {
  return state.paymentRows.map((payment, index) => `
    <div class="payment-row">
      <label>Forma
        <select data-payment-method="${index}">
          ${Object.entries(paymentLabels).map(([method, label]) => `<option value="${method}" ${payment.method === method ? "selected" : ""}>${label}</option>`).join("")}
        </select>
      </label>
      <label>Valor (R$)
        <input data-payment-amount="${index}" type="number" min="0" step="0.01" value="${(payment.amountCents / 100).toFixed(2)}">
      </label>
      ${payment.method === "CASH" ? `<label>Recebido (R$)
        <input data-payment-received="${index}" type="number" min="0" step="0.01" value="${payment.receivedCents === null ? "" : (payment.receivedCents / 100).toFixed(2)}" placeholder="Igual ao valor">
      </label>` : ""}
      ${state.paymentRows.length > 1 ? `<button class="remove-button" type="button" data-action="remove-payment" data-index="${index}">Remover</button>` : ""}
    </div>`).join("");
}

function formatMoney(cents) {
  return new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" })
    .format((Number(cents) || 0) / 100);
}

function parseMoney(value) {
  const normalized = String(value ?? "").trim().replace(/\s/g, "").replace(",", ".");
  if (!/^\d+(\.\d{0,2})?$/.test(normalized)) return null;
  const [whole, fraction = ""] = normalized.split(".");
  const cents = Number(whole) * 100 + Number(fraction.padEnd(2, "0"));
  return Number.isSafeInteger(cents) ? cents : null;
}

function showToast(message, isError = false) {
  const toast = $("#toast");
  toast.textContent = message;
  toast.classList.toggle("error", isError);
  toast.classList.add("show");
  clearTimeout(state.toastTimer);
  state.toastTimer = setTimeout(() => toast.classList.remove("show"), 3600);
}

function requestText(title, label, { value = "", placeholder = "", maxLength = 200, inputMode = "text" } = {}) {
  const dialog = $("#inputDialog");
  const form = $("#inputDialogForm");
  const input = $("#inputDialogValue");
  $("#inputDialogTitle").textContent = title;
  $("#inputDialogLabel").textContent = label;
  input.value = value;
  input.placeholder = placeholder;
  input.maxLength = maxLength;
  input.inputMode = inputMode;

  return new Promise((resolve) => {
    const cleanup = () => {
      dialog.removeEventListener("close", onClose);
      form.removeEventListener("submit", onSubmit);
      $("#cancelInputDialog").removeEventListener("click", onCancel);
      $("#closeInputDialog").removeEventListener("click", onCancel);
    };
    const finish = (result) => {
      cleanup();
      resolve(result);
    };
    const onClose = () => finish(dialog.returnValue === "confirm" ? input.value : null);
    const onSubmit = (event) => {
      event.preventDefault();
      dialog.close("confirm");
    };
    const onCancel = () => dialog.close();
    dialog.addEventListener("close", onClose, { once: true });
    form.addEventListener("submit", onSubmit);
    $("#cancelInputDialog").addEventListener("click", onCancel);
    $("#closeInputDialog").addEventListener("click", onCancel);
    dialog.showModal();
    input.focus();
  });
}

async function api(path, options = {}) {
  const method = options.method ?? "GET";
  const headers = { Accept: "application/json", ...(options.headers ?? {}) };
  if (options.body !== undefined) headers["Content-Type"] = "application/json";
  if (!["GET", "HEAD"].includes(method) && !["/api/setup", "/api/auth/login"].includes(path)) {
    headers["X-CSRF-Token"] = state.csrf;
  }
  const response = await fetch(path, {
    ...options,
    method,
    headers,
    credentials: "same-origin",
    body: options.body === undefined ? undefined : JSON.stringify(options.body),
  });
  const result = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401 && state.user) {
      state.user = null;
      state.csrf = "";
      $("#appView").classList.add("hidden");
      $("#authView").classList.remove("hidden");
      showToast("Sua sessão expirou. Entre novamente.", true);
    }
    throw new Error(result.error ?? `Falha na requisição (${response.status}).`);
  }
  return result;
}

function setAuthMode(setupRequired) {
  $("#authView").classList.remove("hidden");
  $("#appView").classList.add("hidden");
  $("#loginForm").classList.toggle("hidden", setupRequired);
  $("#setupForm").classList.toggle("hidden", !setupRequired);
  $("#authTitle").textContent = setupRequired ? "Configure sua loja" : "Bem-vindo de volta";
  $("#authDescription").textContent = setupRequired
    ? "Crie o administrador e a primeira unidade para começar."
    : "Entre para acessar o ponto de venda.";
}

async function initialize() {
  try {
    const status = await api("/api/status");
    if (status.setupRequired) return setAuthMode(true);
    const session = await api("/api/me");
    if (!session.authenticated) return setAuthMode(false);
    state.csrf = session.csrfToken;
    await enterApplication(session);
  } catch (error) {
    setAuthMode(true);
    showToast(error.message, true);
  }
}

async function enterApplication(session) {
  state.user = session.user;
  state.branches = session.branches;
  if (!state.branches.length) throw new Error("Cadastre uma unidade para continuar.");
  const saved = Number(localStorage.getItem("pdv_branch"));
  state.branchId = state.branches.some((branch) => branch.id === saved) ? saved : state.branches[0].id;
  $("#branchSelect").innerHTML = state.branches.map((branch) =>
    `<option value="${branch.id}">${escapeHtml(branch.name)}</option>`).join("");
  $("#branchSelect").value = String(state.branchId);
  $("#userName").textContent = state.user.name;
  $("#userRole").textContent = roleLabels[state.user.role];
  $("#userAvatar").textContent = state.user.name.trim().charAt(0).toUpperCase();
  $$(".manager-only").forEach((element) => element.classList.toggle("hidden", state.user.role === "CASHIER"));
  $$(".admin-only").forEach((element) => element.classList.toggle("hidden", state.user.role !== "ADMIN"));
  $("#authView").classList.add("hidden");
  $("#appView").classList.remove("hidden");
  $("#appView").classList.add("sales-active");
  await loadView("sales");
}

async function switchView(view) {
  if (view === "sales") {
    const cash = await api(`/api/cash?branchId=${state.branchId}`);
    if (!cash.open) {
      view = "cash";
      showToast("Abra o caixa desta unidade antes de acessar as vendas.");
    }
  }
  state.view = view;
  $("#appView").classList.toggle("sales-active", view === "sales");
  $$(".nav-link").forEach((button) => button.classList.toggle("active", button.dataset.view === view));
  $$(".view").forEach((section) => section.classList.toggle("hidden", section.id !== `view-${view}`));
  loadView(view).catch((error) => showToast(error.message, true));
}

async function loadView(view) {
  if (view === "sales") await renderSales();
  if (view === "products") await renderProducts();
  if (view === "promotions") await renderPromotions();
  if (view === "labels") await renderBarcodeLabels();
  if (view === "customers") await renderCustomers();
  if (view === "cash") await renderCash();
  if (view === "reports") await renderReports();
  if (view === "settings") await renderSettings();
}

function heading(title, subtitle, actions = "") {
  return `<div class="page-heading"><div><h1>${title}</h1><p>${subtitle}</p></div><div class="heading-actions">${actions}</div></div>`;
}

function productImage(product, className = "product-photo") {
  if (!product.has_image) return `<div class="product-photo-placeholder ${className}" aria-label="Sem imagem">◇</div>`;
  return `<img class="${className}" src="/api/products/${product.id}/image" alt="${escapeHtml(product.name)}" loading="lazy">`;
}

function saleTotal() {
  const subtotal = state.cart.reduce((sum, item) => sum + item.price_cents * item.quantity, 0);
  const discountInput = $("#discountInput");
  const discount = discountInput ? parseMoney(discountInput.value) ?? 0 : 0;
  return { subtotal, discount: Math.min(discount, subtotal), total: Math.max(0, subtotal - discount) };
}

