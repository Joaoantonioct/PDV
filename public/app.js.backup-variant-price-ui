  };
  let result;
  try {
    result = await api("/api/payment-simulator/qr", request);
  } catch (error) {
    if (!/simulação aceita|grandes demais para o QR/i.test(error.message)) throw error;
    state.simulationSnapshot = { ...snapshot, reference, createdAt: new Date().toISOString() };
