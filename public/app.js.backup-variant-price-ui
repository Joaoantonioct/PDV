function syncPaymentRows() {
  const keepAutoAmount = state.paymentRows.length === 1 && state.paymentRows[0].autoAmount;
  state.paymentRows = $$("#paymentRows .payment-row").map((row, index) => {
    const method = $(`[data-payment-method="${index}"]`, row).value;
    const amountCents = parseMoney($(`[data-payment-amount="${index}"]`, row).value);
    const received = $(`[data-payment-received="${index}"]`, row);
    return {
      method,
      amountCents: amountCents ?? 0,
      receivedCents: received?.value ? parseMoney(received.value) : null,
      autoAmount: keepAutoAmount,
    };
