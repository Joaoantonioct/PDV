  const from = report.from ? formatReportDate(report.from) : "Todo o período";
  const to = report.to ? formatReportDate(report.to) : "Todo o período";
  const statusText = report.sale_count === 0 && report.canceled_count === 0 && report.site_order_count === 0
    ? "Sem movimentação de vendas ou pedidos no período"
    : `${report.sale_count} venda(s) no PDV, ${report.site_order_count} pedido(s) do site sem pagamento e ${report.canceled_count} venda(s) cancelada(s)`;

  return `<article id="monthlyReportDocument" class="monthly-report">
