      <div class="report-brand"><span class="report-brand-mark">P</span><div><strong>PontoCerto</strong><span>GESTÃO DE VENDAS</span></div></div>
      <p class="report-kicker">RELATÓRIO GERENCIAL · NÃO FISCAL</p>
      <h1>Fechamento mensal</h1>
      <p class="report-period">${escapeHtml(monthLabel)}</p>
      <div class="report-metadata"><span><small>Unidade</small><strong>${escapeHtml(report.branch.name)}</strong></span>
        <span><small>Período analisado</small><strong>${escapeHtml(from)} a ${escapeHtml(to)}</strong></span>
        <span><small>Gerado em</small><strong>${escapeHtml(pageGenerated)}</strong></span></div>
      <p class="report-status">${escapeHtml(statusText)}</p>
    </header>
    <section class="report-summary">
      <h2>Resumo executivo</h2>
      <div class="report-metrics">
        ${metric("Vendas concluídas no PDV", report.sale_count)}
        ${metric("Faturamento recebido no PDV", formatMoney(report.total_cents))}
        ${metric("Pedidos do site (sem pagamento)", report.site_order_count)}
        ${metric("Valor dos pedidos do site (não recebido)", formatMoney(report.site_order_total_cents))}
        ${metric("Descontos no PDV", formatMoney(report.discount_cents))}
        ${metric("Ticket médio no PDV", formatMoney(report.average_ticket_cents))}
        ${metric("Vendas canceladas no PDV", report.canceled_count)}
        ${metric("Valor cancelado no PDV", formatMoney(report.canceled_total_cents))}
      </div>
      <p class="report-summary-note">O faturamento recebido considera somente as vendas registradas no caixa. Pedidos do site aparecem separados, sem representar pagamento ou entrada de dinheiro. Vendas canceladas não entram no faturamento.</p>
    </section>
    ${reportSection("Fechamento diário do PDV", "Vendas registradas no caixa; cancelamentos ficam identificados separadamente.",
      ["Data", "Vendas", "Subtotal", "Descontos", "Faturamento", "Cancelamentos"], dailyRows, "Nenhuma venda no período selecionado.")}
    ${reportSection("Pedidos do site por dia", "Pedidos recebidos do site, sem pagamento processado e sem efeito no caixa.",
      ["Data", "Pedidos", "Valor dos pedidos (não recebido)"], siteDailyRows, "Nenhum pedido do site no período selecionado.")}
    ${reportSection("Formas de pagamento do PDV", "Valores registrados por meio de pagamento no caixa. Pedidos do site não são pagamentos.",
      ["Meio", "Concluídos", "Cancelados"], paymentRows, "Sem pagamentos registrados no período.")}
    ${reportSection("Desempenho por operador do PDV", "Vendas concluídas e cancelamentos agrupados pelo usuário que registrou a venda no caixa.",
      ["Operador", "Vendas", "Faturamento", "Cancelamentos"], cashierRows, "Nenhuma venda registrada no período.")}
    ${reportSection("Produtos vendidos ou pedidos", "Itens de vendas do PDV e de pedidos do site aparecem identificados por origem.",
      ["Origem", "Produto", "Quantidade", "Vendas/pedidos", "Total dos itens"], productRows, "Nenhum produto vendido ou pedido no período.")}
    ${reportSection("Conferência de caixa", "Caixas abertos ou encerrados no período. Diferença compara o valor contado no fechamento com o saldo esperado em dinheiro.",
