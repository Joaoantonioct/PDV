    ${reportSection("Movimentações de estoque", "Entradas, saídas, vendas, cancelamentos e transferências registradas no período.",
      ["Data", "Produto", "Movimento", "Qtd.", "Observação", "Usuário", "Venda"], stockRows, "Nenhuma movimentação de estoque no período.")}
    ${reportSection("Vendas detalhadas no PDV", "Uma linha por venda registrada no caixa; cancelamentos, descontos e formas de pagamento ficam discriminados.",
      ["Venda", "Data e hora", "Operador", "Cliente", "Pagamento", "Subtotal", "Desconto", "Total", "Status / motivo"], salesRows, "Nenhuma venda no período selecionado.")}
