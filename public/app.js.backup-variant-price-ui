function updatePaymentBalance() {
  const balanceElement = $("#paymentBalance");
  if (!balanceElement) return;
  const total = saleTotal().total;
  const paid = $$("#paymentRows [data-payment-amount]").reduce((sum, input) => sum + (parseMoney(input.value) ?? 0), 0);
  const balance = total - paid;
  balanceElement.textContent = balance > 0
    ? `Falta pagar ${formatMoney(balance)}`
    : balance < 0 ? `Pagamento excede o total em ${formatMoney(Math.abs(balance))}` : "Pagamento completo";
  balanceElement.classList.toggle("invalid", balance !== 0);
  balanceElement.classList.toggle("valid", balance === 0);
}

