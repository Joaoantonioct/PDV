  const stockRows = report.stockMovements.map((movement) => [
    formatReportDate(movement.created_at, true),
    escapeHtml(movement.product_name),
    escapeHtml(movement.source === "SITE"
      ? "Venda pelo site"
      : movementNames[movement.kind] ?? movement.kind),
    movement.quantity,
    escapeHtml(movement.note || "—"),
    escapeHtml(movement.user_name),
    movement.sale_id ? `#${movement.sale_id}` : "—",
