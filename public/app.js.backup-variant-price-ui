  $("#paymentDialogContent").innerHTML = `
    <div class="dialog-heading">
      <div><p class="eyebrow">SIMULADOR GRATUITO</p><h2>Pagamento por QR de teste</h2></div>
      <button class="button ghost small-button" type="button" data-action="close-payment-dialog">Fechar</button>
