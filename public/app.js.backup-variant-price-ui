  const cancelled = report.methods.filter((row) => row.status === "CANCELED");
  const paymentMethods = [...new Set(report.methods.map((row) => row.method))];
  const methodsByStatus = (rows, method) => rows.find((row) => row.method === method)?.amount_cents ?? 0;
  const cashOut = report.cashMovements.filter((movement) => movement.kind === "OUT")
    .reduce((sum, movement) => sum + movement.amount_cents, 0);
  const cashIn = report.cashMovements.filter((movement) => movement.kind === "IN")
    .reduce((sum, movement) => sum + movement.amount_cents, 0);
  const pageGenerated = new Intl.DateTimeFormat("pt-BR", { dateStyle: "short", timeStyle: "short" }).format(new Date());
  const metric = (label, value, detail = "") => `<div class="report-metric"><span>${label}</span><strong>${value}</strong>${detail ? `<small>${detail}</small>` : ""}</div>`;
  const salesRows = report.sales.map((sale) => [
    `#${sale.id}`,
    formatReportDate(sale.created_at, true),
    escapeHtml(sale.cashier),
    escapeHtml(sale.customer || "Consumidor"),
    escapeHtml(sale.payment_methods ?? "—"),
    formatMoney(sale.subtotal_cents),
    formatMoney(sale.discount_cents),
    formatMoney(sale.total_cents),
    `${sale.status === "CANCELED" ? "Cancelada" : "Concluída"}${sale.canceled_at ? `<small class="report-cell-note">Em ${formatReportDate(sale.canceled_at, true)}</small>` : ""}${sale.cancel_reason ? `<small class="report-cell-note">${escapeHtml(sale.cancel_reason)}</small>` : ""}`,
  ]);
  const itemRows = report.saleItems.map((item) => [
    `#${item.sale_id}`,
    formatReportDate(item.created_at, true),
    escapeHtml(item.product_name),
    item.quantity,
    formatMoney(item.unit_price_cents),
    formatMoney(item.total_cents),
    item.status === "CANCELED" ? "Cancelada/estornada" : "Concluída",
  ]);
  const dailyRows = report.daily.map((day) => [
    formatReportDate(day.sale_date),
    day.sale_count,
    formatMoney(day.subtotal_cents),
    formatMoney(day.discount_cents),
    `<strong>${formatMoney(day.total_cents)}</strong>`,
    `${day.canceled_count} · ${formatMoney(day.canceled_total_cents)}`,
  ]);
  const paymentRows = paymentMethods.map((method) => [
    escapeHtml(paymentLabels[method] ?? method),
    formatMoney(methodsByStatus(completed, method)),
    formatMoney(methodsByStatus(cancelled, method)),
  ]);
  const productRows = report.products.map((product) => [
    product.channel === "SITE" ? "Site" : "PDV",
    escapeHtml(product.product_name),
    product.quantity,
    product.sale_count,
    formatMoney(product.item_total_cents),
  ]);
  const siteDailyRows = report.siteDaily.map((day) => [
    formatReportDate(day.order_date),
    day.order_count,
    formatMoney(day.total_cents),
  ]);
  const siteOrderRows = report.siteSales.map((order) => [
    escapeHtml(order.order_id),
    formatReportDate(order.created_at, true),
    order.item_count,
    formatMoney(order.total_cents),
