function formatReportDate(value, includeTime = false) {
  if (!value) return "—";
  const date = new Date(value.includes("T") ? value : `${value.replace(" ", "T")}Z`);
  if (!Number.isFinite(date.getTime())) return escapeHtml(value);
  return new Intl.DateTimeFormat("pt-BR", includeTime
    ? { dateStyle: "short", timeStyle: "short" }
    : { dateStyle: "short", timeZone: "UTC" }).format(date);
}

function reportTable(headers, rows, emptyMessage) {
  if (!rows.length) return `<div class="report-empty">${escapeHtml(emptyMessage)}</div>`;
  return `<div class="report-table-wrap"><table class="report-table"><thead><tr>${headers.map((header) => `<th>${header}</th>`).join("")}</tr></thead><tbody>
    ${rows.map((row) => `<tr>${row.map((cell) => `<td>${cell}</td>`).join("")}</tr>`).join("")}
    </tbody></table></div>`;
}

function reportSection(title, description, headers, rows, emptyMessage) {
  return `<section class="report-section"><div class="report-section-title"><div><h2>${title}</h2><p>${description}</p></div></div>${reportTable(headers, rows, emptyMessage)}</section>`;
}

function buildMonthlyReport(report, month) {
  const monthLabel = new Intl.DateTimeFormat("pt-BR", { month: "long", year: "numeric", timeZone: "UTC" })
