{
  "name": "pdv-multilojas",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de ponto de venda para Windows com SQLite",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "br.com.pontocerto.pdv",
    "productName": "PontoCerto PDV",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.cjs",
      "server.mjs",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop-config.example",
        "to": "desktop-config.example"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
