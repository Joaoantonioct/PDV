# Configurações do PDV
PORT=3000

# Sincronização com o site LDM (opcional)
# Configure o mesmo token no .env do projeto LDM
PDV_SITE_SYNC_URL=https://seu-site.com
PDV_SITE_SYNC_TOKEN=seu-token-aqui
PDV_SITE_SYNC_BRANCH_NAME=Unidade principal

# Cookie seguro (use true em produção com HTTPS)
PDV_COOKIE_SECURE=false

# Caminho do banco de dados (opcional, padrão: data/pdv.sqlite)
# PDV_DB_PATH=C:\pdv\data\pdv.sqlite
